+// ---- mc_capture: D3D11 colour + depth readback ----------------------------
+//
+// Called from gfx_d3d11_end_frame(), i.e. after the full frame (scene + HUD)
+// has been submitted and before IDXGISwapChain::Present(). We copy the
+// back-buffer and the game's depth texture into CPU-readable staging textures
+// and map them. The colour is already R8G8B8A8_UNORM (see gfx_dxgi.cpp), which
+// matches the shared-memory layout; the depth is copied row-by-row into the
+// tightly-packed f32 region (staging RowPitch is usually != w*4).
+//
+// D32_FLOAT is the format used on feature level 10_0+ (the common case). On a
+// D24_UNORM_S8_UINT device the depth copy is skipped (documented limitation);
+// see README.md.
+
+static bool mc_capture_d3d11_make_staging(ComPtr<ID3D11Texture2D> &staging,
+                                          DXGI_FORMAT format, uint32_t w, uint32_t h) {
+    if (staging.Get() != nullptr) { return true; }
+    D3D11_TEXTURE2D_DESC desc;
+    ZeroMemory(&desc, sizeof(desc));
+    desc.Width = w;
+    desc.Height = h;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = format;
+    desc.SampleDesc.Count = 1;
+    desc.SampleDesc.Quality = 0;
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    desc.MiscFlags = 0;
+    HRESULT hr = d3d.device->CreateTexture2D(&desc, nullptr, staging.GetAddressOf());
+    return SUCCEEDED(hr) && staging.Get() != nullptr;
+}
+
+static void mc_capture_d3d11_readback(McCaptureFrame *f, uint32_t w, uint32_t h) {
+    D3D11_MAPPED_SUBRESOURCE ms;
+
+    // Colour: back-buffer -> staging -> shared memory (RGBA8).
+    if (d3d.backbuffer_texture) {
+        if (mc_capture_d3d11_make_staging(d3d.color_staging, DXGI_FORMAT_R8G8B8A8_UNORM, w, h)) {
+            d3d.context->CopyResource(d3d.color_staging.Get(), d3d.backbuffer_texture.Get());
+            if (SUCCEEDED(d3d.context->Map(d3d.color_staging.Get(), 0, D3D11_MAP_READ, 0, &ms))) {
+                for (uint32_t y = 0; y < h; y++) {
+                    memcpy(f->color + (size_t)y * w * 4,
+                           (const uint8_t *)ms.pData + (size_t)y * ms.RowPitch,
+                           (size_t)w * 4);
+                }
+                d3d.context->Unmap(d3d.color_staging.Get(), 0);
+            }
+        }
+    }
+
+    // Depth: game depth texture -> staging -> shared memory (f32, 0..1).
+    if (d3d.depth_stencil_texture) {
+        D3D11_TEXTURE2D_DESC ddesc;
+        d3d.depth_stencil_texture->GetDesc(&ddesc);
+        if (ddesc.Format == DXGI_FORMAT_D32_FLOAT) {
+            if (mc_capture_d3d11_make_staging(d3d.depth_staging, DXGI_FORMAT_R32_FLOAT, w, h)) {
+                d3d.context->CopyResource(d3d.depth_staging.Get(), d3d.depth_stencil_texture.Get());
+                if (SUCCEEDED(d3d.context->Map(d3d.depth_staging.Get(), 0, D3D11_MAP_READ, 0, &ms))) {
+                    for (uint32_t y = 0; y < h; y++) {
+                        memcpy((uint8_t *)f->depth + (size_t)y * w * 4,
+                               (const uint8_t *)ms.pData + (size_t)y * ms.RowPitch,
+                               (size_t)w * 4);
+                    }
+                    d3d.context->Unmap(d3d.depth_staging.Get(), 0);
+                }
+            }
+        } else {
+            static bool warned = false;
+            if (!warned) {
+                warned = true;
+                fprintf(stderr, "[mc_capture] D3D11 depth format %u is not D32_FLOAT; depth not captured\n",
+                        (unsigned)ddesc.Format);
+            }
+        }
+    }
+}
+
 static void gfx_d3d11_end_frame(void) {
+    // mc_capture: the scene + HUD are fully submitted; we are still bound to
+    // the back-buffer and before IDXGISwapChain::Present() (which runs in
+    // gfx_dxgi_swap_buffers_begin()). Hook here for D3D11.
+    if (mc_capture_should_capture()) {
+        McCaptureFrame f;
+        uint32_t w = d3d.current_width;
+        uint32_t h = d3d.current_height;
+
+        if (mc_capture_begin(&f, w, h, MC_DEPTH_CONVENTION_D3D_0_TO_1, 0u)) {
+            mc_capture_d3d11_readback(&f, w, h);
+            mc_capture_end(&f);
+        }
+    }
 }
 
